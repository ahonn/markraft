{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markraft-website",
  "compatibility_date": "2026-09-26",
  // A static site: no Worker script, only the built pages.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [{ "pattern": "markraft.app", "custom_domain": true }]
}
