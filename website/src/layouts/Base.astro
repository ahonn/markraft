---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  structuredData: object[];
}

const { title, description, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Markraft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
    <script>
      // Clips play only while on screen. With reduced motion they wait for the viewer
      // to press play instead.
      const clips = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        clips.forEach((clip) => (clip.controls = true));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const { target, isIntersecting } of entries) {
              const clip = target as HTMLVideoElement;
              if (isIntersecting) clip.play().catch(() => (clip.controls = true));
              else clip.pause();
            }
          },
          { threshold: 0.35 },
        );
        clips.forEach((clip) => observer.observe(clip));
      }
    </script>
  </body>
</html>
