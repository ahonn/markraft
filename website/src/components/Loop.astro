---
interface Props {
  name: string;
  label: string;
  width: number;
  height: number;
  class?: string;
}

const { name, label, width, height, class: className } = Astro.props;
---

<video
  data-loop
  class:list={['block h-auto w-full', className]}
  autoplay
  muted
  loop
  playsinline
  poster={`/media/${name}.jpg`}
  width={width}
  height={height}
  aria-label={label}
>
  <source src={`/media/${name}.mp4`} type="video/mp4" />
</video>
